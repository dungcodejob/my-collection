{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@app/configs": ["src/@core/configs"],
      "@app/configs/*": ["src/@core/configs/*"],
      "@app/entities": ["src/@shared/entities"],
      "@app/entities/*": ["src/@shared/entities/*"],
      "@app/repositories": ["src/@shared/repositories"],
      "@app/repositories/*": ["src/@shared/repositories/*"],
      "@app/account": ["src/account"],
      "@app/account/*": ["src/account/*"],
      "@app/constants": ["src/@shared/constants"],
      "@app/constants/*": ["src/@shared/constants/*"],
      "@app/utils": ["src/@shared/utils"],
      "@app/utils/*": ["src/@shared/utils/*"],
      "@app/errors": ["src/@shared/errors"],
      "@app/errors/*": ["src/@shared/errors/*"],
      "@app/session": ["src/session"],
      "@app/session/*": ["src/session/*"],
      "@app/auth": ["src/auth"],
      "@app/auth/*": ["src/auth/*"],
      "@app/user": ["src/user"],
      "@app/user/*": ["src/user/*"],
      "@app/decorators": ["src/@shared/decorators"],
      "@app/decorators/*": ["src/@shared/decorators/*"],
      "@app/interceptors": ["src/@shared/interceptors"],
      "@app/interceptors/*": ["src/@shared/interceptors/*"],
      "@app/filters": ["src/@shared/filters"],
      "@app/filters/*": ["src/@shared/filters/*"],
      "@app/models": ["src/@shared/models"],
      "@app/models/*": ["src/@shared/models/*"],
      "@app/tests": ["src/@core/tests"],
      "@app/tests/*": ["src/@core/tests/*"],
      "@app/factories": ["src/@shared/factories"],
      "@app/factories/*": ["src/@shared/factories/*"],
      "@app/services": ["src/@shared/services"],
      "@app/services/*": ["src/@shared/services/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
