{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@app/configs": ["src/configs"],
      "@app/configs/*": ["src/configs/*"],
      "@app/entities": ["src/shared/entities"],
      "@app/entities/*": ["src/shared/entities/*"],
      "@app/repositories": ["src/shared/repositories"],
      "@app/repositories/*": ["src/shared/repositories/*"],
      "@app/account": ["src/account"],
      "@app/account/*": ["src/account/*"],
      "@app/constants": ["src/shared/constants"],
      "@app/constants/*": ["src/shared/constants/*"],
      "@app/utils": ["src/shared/utils"],
      "@app/utils/*": ["src/shared/utils/*"],
      "@app/errors": ["src/shared/errors"],
      "@app/errors/*": ["src/shared/errors/*"],
      "@app/session": ["src/session"],
      "@app/session/*": ["src/session/*"],
      "@app/auth": ["src/auth"],
      "@app/auth/*": ["src/auth/*"],
      "@app/user": ["src/user"],
      "@app/user/*": ["src/user/*"],
      "@app/decorators": ["src/shared/decorators"],
      "@app/decorators/*": ["src/shared/decorators/*"],
      "@app/interceptors": ["src/shared/interceptors"],
      "@app/interceptors/*": ["src/shared/interceptors/*"],
      "@app/models": ["src/shared/models"],
      "@app/models/*": ["src/shared/models/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
