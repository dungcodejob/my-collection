{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@core/*": [
        "src/app/core/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@security/*": [
        "src/app/features/security/*"
      ],
      "@collection/*": [
        "src/app/features/collection/*"
      ],
      "@bookmark/*": [
        "src/app/features/bookmark/*"
      ],
      "@shell/*": [
        "src/app/features/shell/*"
      ],
      "@spartan-ng/ui-button-helm": [
        ".\\libs/ui-button-helm/src/index.ts"
      ],
      "@spartan-ng/ui-input-helm": [
        ".\\libs/ui-input-helm/src/index.ts"
      ],
      "@spartan-ng/ui-label-helm": [
        ".\\libs/ui-label-helm/src/index.ts"
      ],
      "@spartan-ng/ui-checkbox-helm": [
        ".\\libs/ui-checkbox-helm/src/index.ts"
      ],
      "@spartan-ng/ui-icon-helm": [
        ".\\libs/ui-icon-helm/src/index.ts"
      ],
      "@spartan-ng/ui-menu-helm": [
        ".\\libs/ui-menu-helm/src/index.ts"
      ],
      "@spartan-ng/ui-sonner-helm": [
        ".\\libs/ui-sonner-helm/src/index.ts"
      ],
      "@spartan-ng/ui-dialog-helm": [
        ".\\libs/ui-dialog-helm/src/index.ts"
      ],
      "@spartan-ng/ui-alertdialog-helm": [
        ".\\libs/ui-alertdialog-helm/src/index.ts"
      ],
      "@spartan-ng/ui-spinner-helm": [
        ".\\libs/ui-spinner-helm/src/index.ts"
      ],
      "@spartan-ng/ui-card-helm": [
        ".\\libs/ui-card-helm/src/index.ts"
      ],
      "@spartan-ng/ui-typography-helm": [
        ".\\libs/ui-typography-helm/src/index.ts"
      ],
      "@spartan-ng/ui-skeleton-helm": [
        ".\\libs/ui-skeleton-helm/src/index.ts"
      ],
      "@spartan-ng/ui-badge-helm": [
        ".\\libs/ui-badge-helm/src/index.ts"
      ],
      "@spartan-ng/ui-popover-helm": [
        ".\\libs/ui-popover-helm/src/index.ts"
      ],
      "@spartan-ng/ui-command-helm": [
        ".\\libs/ui-command-helm/src/index.ts"
      ],
      "@spartan-ng/ui-select-helm": [
        ".\\libs/ui-select-helm/src/index.ts"
      ]
    },
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
