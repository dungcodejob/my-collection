{
  "mode": "prod",
  "apiBaseUrl": "https://api.mycollection.com",
  "appVersion": "1.0.0",
  "apiKey": "prod-key-456",
  "featureFlags": {
    "enableBookmarkSync": true,
    "enableCategories": true
  },
  "theme": {
    "default": "dark",
    "available": ["light", "dark", "system"]
  },
  "loggingLevel": "error",
  "endpoints": {
    "auth": "/api/auth",
    "bookmarks": "/api/bookmarks",
    "settings": "/api/bookmark/settings"
  },
  "analytics": {
    "enabled": true,
    "trackingId": "UA-123456-1"
  },
  "timeout": 15000,
  "retryPolicies": {
    "maxRetries": 2,
    "retryDelay": 500
  }
}
