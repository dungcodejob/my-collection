    "prettier": "^3.6.2",
    "stylelint": "^16.23.0",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-standard": "^39.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.6",
    "ts-jest": "29.4.5",
