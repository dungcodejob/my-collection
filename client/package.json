    "@angular/language-service": "20.3.13",
    "@eslint/js": "^9.8.0",
    "@happy-dom/jest-environment": "^18.0.1",
    "@nx/angular": "22.1.1",
    "@nx/eslint": "22.1.1",
    "@nx/eslint-plugin": "22.1.1",
    "@nx/jest": "22.1.1",
    "@nx/js": "22.1.1",
    "@nx/web": "22.1.1",
    "@nx/workspace": "22.1.1",
    "@schematics/angular": "20.3.9",
    "@spartan-ng/cli": "^0.0.1-alpha.543",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "30.0.0",
    "@types/node": "18.16.9",
    "@typescript-eslint/utils": "8.40.0",
    "angular-eslint": "20.3.0",
    "autoprefixer": "^10.4.0",
